[gd_resource type="Resource" script_class="WaveDefinition" format=3]

[ext_resource type="Script" path="res://scripts/definitions/wave_definition.gd" id="1_wave"]
[ext_resource type="Script" path="res://scripts/definitions/wave_enemy_entry_definition.gd" id="2_entry"]

[sub_resource type="Resource" id="Resource_bark_beetle_entry"]
script = ExtResource("2_entry")
enemy_id = &"bark_beetle"
base_count_per_side = 4
count_scaling_start_stage_wave = 1
count_increase_interval = 100
count_increase_amount = 1
maximum_count_per_side = 16
health_multiplier = 1.0
damage_multiplier = 1.0

[sub_resource type="Resource" id="Resource_bark_runner_entry"]
script = ExtResource("2_entry")
enemy_id = &"bark_runner"
base_count_per_side = 2
count_scaling_start_stage_wave = 1
count_increase_interval = 100
count_increase_amount = 1
maximum_count_per_side = 10
health_multiplier = 1.0
damage_multiplier = 1.0

[resource]
script = ExtResource("1_wave")
wave_id = &"guardian_grove_substage_finale"
display_name = "Guardian Grove Substage Finale"
enemy_entries = Array[ExtResource("2_entry")]([SubResource("Resource_bark_beetle_entry"), SubResource("Resource_bark_runner_entry")])
spawn_interval = 0.18
completion_message_duration = 0.8
time_after_wave = 1.0
