[gd_resource type="Resource" script_class="WaveDefinition" format=3]

[ext_resource type="Script" path="res://scripts/definitions/wave_definition.gd" id="1_wave"]
[ext_resource type="Script" path="res://scripts/definitions/wave_enemy_entry_definition.gd" id="2_entry"]

[sub_resource type="Resource" id="Resource_colossus_entry"]
script = ExtResource("2_entry")
enemy_id = &"ancient_bark_colossus"
base_count_per_side = 1
count_increase_interval = 0
count_increase_amount = 0
maximum_count_per_side = 1

[resource]
script = ExtResource("1_wave")
wave_id = &"guardian_grove_boss"
display_name = "Guardian Grove Boss"
description = "One Ancient Bark Colossus attacks from each side."
enemy_entries = Array[ExtResource("2_entry")]([SubResource("Resource_colossus_entry")])
spawn_interval = 0.25
completion_message_duration = 0.7
time_after_wave = 0.5
