[gd_resource type="Resource" script_class="StageDefinition" format=3]

[ext_resource type="Script" path="res://scripts/definitions/stage_definition.gd" id="1_stage"]
[ext_resource type="Script" path="res://scripts/definitions/wave_definition.gd" id="2_wave"]
[ext_resource type="Resource" path="res://resources/waves/standard_bark_beetle_wave.tres" id="3_standard_wave"]

[resource]
script = ExtResource("1_stage")
stage_id = &"guardian_grove"
display_name = "Guardian Grove"
description = "The repeating prototype Stage used for the current endless wave progression."
waves = Array[ExtResource("2_wave")]([ExtResource("3_standard_wave")])
wave_count = 100
repeat_indefinitely = true
enemies_per_side_increase_interval = 3
maximum_enemies_per_side = 30
health_increase_per_global_wave = 3.0
maximum_enemy_health = 1000000.0
completion_essence_reward = 0
completion_effect_ids = Array[StringName]([])
