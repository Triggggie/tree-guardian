display_name = "Guardian Grove"
description = "The repeating prototype Stage used for the current endless wave progression."
substages = Array[ExtResource("2_substage")]([ExtResource("3_substage_01"), ExtResource("4_substage_02"), ExtResource("5_substage_03"), ExtResource("6_substage_04"), ExtResource("7_substage_05"), ExtResource("8_substage_06"), ExtResource("9_substage_07"), ExtResource("10_substage_08"), ExtResource("11_substage_09"), ExtResource("12_substage_10")])
