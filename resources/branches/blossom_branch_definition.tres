[gd_resource type="Resource" script_class="BranchDefinition" format=3]

[ext_resource type="Script" path="res://scripts/definitions/branch_definition.gd" id="1_branch"]
[ext_resource type="Script" path="res://scripts/definitions/targeting_profile.gd" id="2_targeting"]
[ext_resource type="PackedScene" path="res://scenes/branches/blossom_branch.tscn" id="3_scene"]
[ext_resource type="Script" path="res://scripts/definitions/upgrade_definition.gd" id="4_upgrade"]
[ext_resource type="Resource" path="res://resources/upgrades/blossom/healing_per_tick.tres" id="5_healing_per_tick"]
[ext_resource type="Resource" path="res://resources/upgrades/blossom/healing_speed.tres" id="6_healing_speed"]
[ext_resource type="Resource" path="res://resources/upgrades/blossom/petal_damage.tres" id="7_petal_damage"]
[ext_resource type="Resource" path="res://resources/talents/blossom/blossom_talent_tree.tres" id="8_talent_tree"]

[sub_resource type="Resource" id="Resource_targeting"]
script = ExtResource("2_targeting")
target_group = &"enemies"
target_priority = 0
lane_mode = 0
preferred_lane_span = 1

[resource]
script = ExtResource("1_branch")
branch_id = &"blossom_branch"
display_name = "Blossom Branch"
description = "A support branch that heals the tree and attacks enemies with ranged petals."
category_id = &"standard"
legendary_tier = 0
branch_scene = ExtResource("3_scene")
targeting_profile = SubResource("Resource_targeting")
upgrades = Array[ExtResource("4_upgrade")]([ExtResource("5_healing_per_tick"), ExtResource("6_healing_speed"), ExtResource("7_petal_damage")])
talent_tree = ExtResource("8_talent_tree")
