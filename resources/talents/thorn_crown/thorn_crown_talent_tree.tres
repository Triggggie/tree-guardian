[gd_resource type="Resource" script_class="TalentTreeDefinition" format=3]

[ext_resource type="Script" path="res://scripts/definitions/talent_definition.gd" id="1_talent"]
[ext_resource type="Script" path="res://scripts/definitions/talent_tree_definition.gd" id="2_tree"]
[ext_resource type="Resource" path="res://resources/talents/thorn_crown/barbed_core.tres" id="3_barbed"]
[ext_resource type="Resource" path="res://resources/talents/thorn_crown/twin_torment.tres" id="4_twin"]
[ext_resource type="Resource" path="res://resources/talents/thorn_crown/overgrowth.tres" id="5_overgrowth"]

[resource]
script = ExtResource("2_tree")
